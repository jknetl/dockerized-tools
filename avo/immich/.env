# Non-secret configuration (committed). Secrets live in db_password.secrets (gitignored).
# Docs: https://docs.immich.app/install/environment-variables

STORAGE_DIR=/home/docker/immich

# Pin to an exact release; read release notes before bumping (breaking changes happen).
IMMICH_VERSION=v3.3.5

# UID:GID all containers run as; must own everything under $STORAGE_DIR
IMMICH_UID=1000
IMMICH_GID=1000

TZ=Europe/Prague

# Read by immich-server (env_file) and used for postgres init (interpolation)
DB_USERNAME=immich
DB_DATABASE_NAME=immich
